# Postgres connection string.
# Local dev: create a free database at https://neon.tech and paste its URL here.
# Vercel:    add DATABASE_URL in Settings → Environment Variables (same value).
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Setup commands:
#   npm install
#   npx prisma db push        # creates tables in the cloud DB
#   npm run db:seed           # seeds 4 users + 650 crimes
